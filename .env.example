# Nearhand settings. Copy to .env for local runs (npm start loads it; git ignores it).
# On Render, set these in the service's Environment tab instead. Every variable is optional for local runs.

# --- Database ---------------------------------------------------------------
# Unset: a local SQLite file (server/data/nearhand.db), nothing to install.
# Set: PostgreSQL. For Aiven, use the Service URI from the console (it contains the password: keep it secret).
DATABASE_URL=
# Aiven's CA certificate (Overview page > CA certificate), PEM text. Multi-line, or one line with \n escapes.
AIVEN_CA_CERT=
# Postgres connections the app may open (2-8, default 6; Aiven's free plan allows 20 in total).
PG_POOL_MAX=
# SQLite file path, when DATABASE_URL is unset.
DB_FILE=

# --- Web server --------------------------------------------------------------
# Render sets PORT itself.
PORT=
# production: trust the proxy's X-Forwarded-For entry for rate limits. Set on Render, not locally.
NODE_ENV=
# The public site address, used in email links and the geocoder's User-Agent; an https:// address also turns on
# secure cookies. On Render: https://<your-service>.onrender.com
APP_URL=
SESSION_DAYS=

# --- Notification emails via Resend (optional; without them notifications stay in-app) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REDIRECT_TO=
